<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageLabel = title or venue -%}
  <title>{% if pageLabel and pageLabel != "The Cord Suit" %}{{ pageLabel }} &middot; {% endif %}The Cord Suit</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="layout-{{ layout | default('plain') }}{% if category %} section-{{ category }}{% endif %}">
  {% include "header.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
